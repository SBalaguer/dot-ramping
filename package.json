{
  "name": "onramp-bridges",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json && tsc -p forks/tsconfig.json && tsc -p packages/chains/tsconfig.json",
    "forks:up": "pnpm -F @onramp/forks run up",
    "forks:down": "pnpm -F @onramp/forks run down",
    "check:forks": "pnpm -F @onramp/forks run check",
    "check:env": "tsx --env-file-if-exists=.env scripts/check-env.ts"
  },
  "dependencies": {
    "@galacticcouncil/descriptors": "2.7.0",
    "@onramp/chains": "workspace:*",
    "@onramp/forks": "workspace:*",
    "polkadot-api": "^2.2.2",
    "viem": "^2.58.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "packageExtensions": {
      "@galacticcouncil/chopsticks@2.0.0": {
        "dependencies": {
          "@acala-network/chopsticks-db": "npm:@galacticcouncil/chopsticks-db@2.0.0"
        }
      },
      "@polkadot-api/json-rpc-provider-proxy": {
        "dependencies": {
          "@polkadot-api/json-rpc-provider": "0.2.0"
        }
      }
    }
  }
}
