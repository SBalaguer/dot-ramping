{
  "name": "onramp-bridges",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "bootstrap": "pnpm -F @onramp/contracts run deps && pnpm whm:build",
    "whm:build": "cd third_party/whm/contracts && forge soldeer install && git checkout -- soldeer.lock && forge build",
    "lint": "eslint . && prettier --check . && pnpm -F @onramp/contracts run lint",
    "format": "prettier --write . && forge fmt --root contracts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm lint && pnpm typecheck && pnpm -F @onramp/contracts run build && vitest run && pnpm -F @onramp/contracts run test",
    "forks:up": "pnpm -F @onramp/forks run up",
    "forks:down": "pnpm -F @onramp/forks run down",
    "check:forks": "pnpm -F @onramp/forks run check",
    "check:env": "tsx --env-file-if-exists=.env scripts/check-env.ts",
    "funding:report": "tsx --env-file-if-exists=.env scripts/funding-report.ts",
    "probe:exchange-asset": "pnpm -F @onramp/forks run probe:exchange-asset"
  },
  "dependencies": {
    "@galacticcouncil/descriptors": "2.7.0",
    "@onramp/chains": "workspace:*",
    "@onramp/forks": "workspace:*",
    "polkadot-api": "^2.2.2",
    "viem": "^2.58.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "@galacticcouncil/chopsticks": "2.3.0",
      "typescript": "$typescript"
    },
    "packageExtensions": {
      "@polkadot-api/json-rpc-provider-proxy": {
        "dependencies": {
          "@polkadot-api/json-rpc-provider": "0.2.0"
        }
      }
    }
  }
}
