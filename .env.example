# EVM source chains (real testnets)
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Ethereum mainnet fork for S-ETH: anvil forks ETH_MAINNET_RPC at ETH_FORK_BLOCK.
# ETH_MAINNET_RPC must be an archive endpoint (a keyed Alchemy, Infura or similar URL).
ETH_MAINNET_RPC=
ETH_FORK_RPC=http://127.0.0.1:8545
ETH_FORK_BLOCK=26478800

# Testnet-only keys. Never reuse a key that has held real funds.
# The factory owner can only rotate the relayer. Its address shapes the factory address; its key is never needed here.
OWNER_EVM_ADDRESS=
RELAYER_EVM_PK=
# The demo "user": `forks:up` funds it on the Ethereum fork and the relayer sends demo deposits from it.
DEV_USER_EVM_PK=

# Polkadot mainnet forks (chopsticks)
HYDRATION_FORK_WS=ws://127.0.0.1:8061
AH_FORK_WS=ws://127.0.0.1:8062

WORMHOLESCAN_API=https://api.testnet.wormholescan.io
ROUTE_THRESHOLD_USD=250

# Relayer. Its database is relayer/data/relayer.sqlite unless RELAYER_DB names another absolute path.
RELAYER_PORT=8787
